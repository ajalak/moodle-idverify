{{!
    @template local_idverify/my_identity

    The learner's own identity verification status.

    Context variables required for this template:
    * verified - bool
    * canstart - bool, show the verify button
    * notavailable - bool, verification is switched off or not configured
    * adminwarning - bool, the HMAC key is missing (shown to site admins)
    * starturl, sesskey - verify button target
    * intro - introduction HTML (admin setting or default string)
    * fullname, idcode (masked), birthdate, country, method, timeverified, nameslocked - when verified
    * continueurl - the page the learner came from (optional, when verified)

    Example context (json):
    {
        "verified": true, "canstart": false, "notavailable": false, "adminwarning": false,
        "starturl": "https://example.test/local/idverify/start.php", "sesskey": "abc", "intro": "<p>Tuvasta oma isik.</p>",
        "fullname": "Mari Maasikas", "idcode": "4xxxxxx1234", "birthdate": null, "country": "EE",
        "method": "Smart-ID", "timeverified": "27 September 2026, 10:00", "nameslocked": true,
        "continueurl": "https://example.test/course/view.php?id=2"
    }
}}
<div class="local-idverify-myidentity">
    {{#adminwarning}}
        <div class="alert alert-danger" role="alert">{{#str}} error:hmackey_admin, local_idverify {{/str}}</div>
    {{/adminwarning}}
    {{#verified}}
        <div class="alert alert-success" role="status">{{#str}} status:verified, local_idverify {{/str}}</div>
        <dl class="row">
            <dt class="col-sm-3">{{#str}} legalname, local_idverify {{/str}}</dt>
            <dd class="col-sm-9">{{fullname}}</dd>
            {{#idcode}}
                <dt class="col-sm-3">{{#str}} idcode, local_idverify {{/str}}</dt>
                <dd class="col-sm-9"><span class="text-monospace">{{idcode}}</span> ({{country}})</dd>
            {{/idcode}}
            {{#birthdate}}
                <dt class="col-sm-3">{{#str}} birthdate, local_idverify {{/str}}</dt>
                <dd class="col-sm-9">{{birthdate}} ({{country}})</dd>
            {{/birthdate}}
            <dt class="col-sm-3">{{#str}} method, local_idverify {{/str}}</dt>
            <dd class="col-sm-9">{{method}}</dd>
            <dt class="col-sm-3">{{#str}} timeverified, local_idverify {{/str}}</dt>
            <dd class="col-sm-9">{{timeverified}}</dd>
        </dl>
        {{#nameslocked}}
            <p class="text-muted">{{#str}} nameslocked, local_idverify {{/str}}</p>
        {{/nameslocked}}
        {{#continueurl}}
            <a href="{{continueurl}}" class="btn btn-primary">{{#str}} continue, core {{/str}}</a>
        {{/continueurl}}
    {{/verified}}
    {{^verified}}
        <div class="local-idverify-intro">{{{intro}}}</div>
        {{#canstart}}
            <form method="post" action="{{starturl}}">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-primary btn-lg">{{#str}} verifynow, local_idverify {{/str}}</button>
            </form>
            <p class="text-muted mt-3">{{#str}} privacynote, local_idverify {{/str}}</p>
        {{/canstart}}
        {{#notavailable}}
            <div class="alert alert-warning" role="alert">{{#str}} error:notavailable, local_idverify {{/str}}</div>
        {{/notavailable}}
    {{/verified}}
</div>
